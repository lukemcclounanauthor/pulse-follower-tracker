name: Update Pulse follower tracker
on:
  schedule:
    - cron: '7 * * * *'
  workflow_dispatch:
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install Pillow==11.3.0
      - name: Update tracker
        env:
          APISH_KEY: ${{ secrets.APISH_KEY }}
        run: python update.py
      - name: Commit updates
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add docs/progress.png docs/status.json
          if ! git diff --cached --quiet; then
            git commit -m "Update follower progress"
            git push
